+AudioServiceStopResult AudioService::JoinWorkersAndProcessor(int64_t deadline_us) {
+    EventBits_t task_exit_mask = 0;
+    if (audio_input_task_handle_ != nullptr) {
+        task_exit_mask |= AS_EVENT_INPUT_TASK_EXITED;
+    }
+    if (audio_output_task_handle_ != nullptr) {
+        task_exit_mask |= AS_EVENT_OUTPUT_TASK_EXITED;
+    }
+    if (opus_codec_task_handle_ != nullptr) {
+        task_exit_mask |= AS_EVENT_CODEC_TASK_EXITED;
+    }
+    if (task_exit_mask != 0) {
+        const int64_t remaining_us = deadline_us - esp_timer_get_time();
+        const TickType_t wait_ticks = remaining_us > 0
+            ? pdMS_TO_TICKS(static_cast<uint32_t>(remaining_us / 1000))
+            : 0;
+        const EventBits_t exited = xEventGroupWaitBits(
+            event_group_, task_exit_mask, pdFALSE, pdTRUE, wait_ticks
+        );
+        if ((exited & task_exit_mask) != task_exit_mask) {
+            ESP_LOGE(TAG, "Timed out joining audio tasks");
+            return AudioServiceStopResult::TaskJoinTimeout;
+        }
+    }
+    audio_input_task_handle_ = nullptr;
+    audio_output_task_handle_ = nullptr;
+    opus_codec_task_handle_ = nullptr;
+
+    // The input task can be inside AudioProcessor::Feed(). Join it before
+    // destroying any processor state that Feed may still reference.
+    if (audio_processor_ != nullptr && runtime_state_.ProcessorPrepared()) {
+        const int64_t remaining_us = deadline_us - esp_timer_get_time();
+        const auto processor_result = audio_processor_->Shutdown(
+            remaining_us > 0 ? static_cast<uint32_t>(remaining_us / 1000) : 0
+        );
+        if (processor_result != AudioProcessorShutdownResult::Complete) {
+            return AudioServiceStopResult::ProcessorJoinTimeout;
+        }
+        runtime_state_.MarkProcessorReleased();
+    }
+    return AudioServiceStopResult::Complete;
+}
+
+bool AudioService::CanDestroy() const {
+    return audio_input_task_handle_ == nullptr && audio_output_task_handle_ == nullptr &&
+        opus_codec_task_handle_ == nullptr && lifecycle_.CanDestroy() &&
+        (audio_processor_ == nullptr || audio_processor_->CanDestroy());
+}
+
+void AudioService::RollbackInitialization() {
+    audio_processor_.reset();
+    wake_word_.reset();
+    if (audio_power_timer_ != nullptr) {
+        esp_timer_stop(audio_power_timer_);
+        esp_timer_delete(audio_power_timer_);
+        audio_power_timer_ = nullptr;
+    }
+    if (opus_encoder_ != nullptr) {
+        esp_opus_enc_close(opus_encoder_);
+        opus_encoder_ = nullptr;
+    }
+    if (opus_decoder_ != nullptr) {
+        esp_opus_dec_close(opus_decoder_);
+        opus_decoder_ = nullptr;
+    }
+    if (input_resampler_ != nullptr) {
+        esp_ae_rate_cvt_close(input_resampler_);
+        input_resampler_ = nullptr;
+    }
+    if (output_resampler_ != nullptr) {
+        esp_ae_rate_cvt_close(output_resampler_);
+        output_resampler_ = nullptr;
+    }
+    if (codec_ != nullptr) {
+        codec_->EnableInput(false);
+        codec_->EnableOutput(false);
+    }
+    codec_ = nullptr;
+    initialized_ = false;
 }
 
