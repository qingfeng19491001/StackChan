@@ -0,0 +1,75 @@
+#ifndef AUDIO_RUNTIME_STATE_H
+#define AUDIO_RUNTIME_STATE_H
+
+enum class AudioRuntimeDrainDisposition {
+    Complete = 0,
+    IncompleteProcessorTail,
+    EncodeFailed,
+};
+
+class AudioRuntimeState {
+public:
+    bool BeginStart()
+    {
+        if (start_active_) {
+            return false;
+        }
+        start_active_ = true;
+        timer_running_ = false;
+        encode_failed_ = false;
+        capture_metadata_pending_ = false;
+        return true;
+    }
+
+    void MarkTimerStarted() { timer_running_ = true; }
+    void MarkTimerStopped() { timer_running_ = false; }
+
+    void RollbackStart()
+    {
+        start_active_ = false;
+        timer_running_ = false;
+        encode_failed_ = false;
+        capture_metadata_pending_ = false;
+    }
+
+    void MarkEncodeFailed() { encode_failed_ = true; }
+    bool EncodeFailed() const { return encode_failed_; }
+
+    void MarkProcessorPrepared() { processor_prepared_ = true; }
+    void MarkProcessorReleased() { processor_prepared_ = false; }
