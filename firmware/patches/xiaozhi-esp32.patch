diff --git a/main/audio/audio_worker_startup_policy.h b/main/audio/audio_worker_startup_policy.h
new file mode 100644
index 0000000..8d7ddcb
--- /dev/null
+++ b/main/audio/audio_worker_startup_policy.h
@@ -0,0 +1,27 @@
+#ifndef AUDIO_WORKER_STARTUP_POLICY_H
+#define AUDIO_WORKER_STARTUP_POLICY_H
+
+enum class AudioWorkerStartupResult {
+    Started = 0,
+    CreationFailed,
+    RollbackFailed,
+};
+
+template <typename CreateInput, typename CreateOutput, typename CreateCodec, typename Rollback>
+AudioWorkerStartupResult StartAudioWorkers(
+    CreateInput create_input,
+    CreateOutput create_output,
+    CreateCodec create_codec,
+    Rollback rollback
+) {
+    const bool input_created = create_input();
+    const bool output_created = create_output();
+    const bool codec_created = create_codec();
+    if (input_created && output_created && codec_created) {
+        return AudioWorkerStartupResult::Started;
+    }
+    return rollback() ? AudioWorkerStartupResult::CreationFailed
+                      : AudioWorkerStartupResult::RollbackFailed;
+}
+
+#endif
diff --git a/main/audio/pcm_frame_accumulator.h b/main/audio/pcm_frame_accumulator.h
new file mode 100644
index 0000000..2977acf
--- /dev/null
+++ b/main/audio/pcm_frame_accumulator.h
@@ -0,0 +1,58 @@
+#ifndef PCM_FRAME_ACCUMULATOR_H
+#define PCM_FRAME_ACCUMULATOR_H
+
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+#include "pcm_tail_policy.h"
+
+class PcmFrameAccumulator {
+public:
+    explicit PcmFrameAccumulator(size_t frame_samples = 0)
+        : frame_samples_(frame_samples)
+    {
+        buffer_.reserve(frame_samples_);
+    }
+
+    void ResetFrameSize(size_t frame_samples)
+    {
+        frame_samples_ = frame_samples;
+        buffer_.clear();
+        buffer_.reserve(frame_samples_);
+    }
+
+    template <typename Emit>
+    void Append(std::vector<int16_t>&& samples, Emit&& emit)
+    {
+        buffer_.insert(buffer_.end(), samples.begin(), samples.end());
+        while (frame_samples_ > 0 && buffer_.size() >= frame_samples_) {
+            if (buffer_.size() == frame_samples_) {
+                emit(std::move(buffer_));
+                buffer_.clear();
+                buffer_.reserve(frame_samples_);
+            } else {
+                emit(std::vector<int16_t>(buffer_.begin(), buffer_.begin() + frame_samples_));
+                buffer_.erase(buffer_.begin(), buffer_.begin() + frame_samples_);
+            }
+        }
+    }
+
+    PcmTailResult Flush()
+    {
+        const auto result = ResolvePcmTail(buffer_.size());
+        buffer_.clear();
+        return result;
+    }
+
+    bool empty() const { return buffer_.empty(); }
+    size_t size() const { return buffer_.size(); }
+    size_t frame_size() const { return frame_samples_; }
+
+private:
+    size_t frame_samples_ = 0;
+    std::vector<int16_t> buffer_;
+};
+
+#endif
