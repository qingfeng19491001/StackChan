new file mode 100644
index 0000000..6b5d497
--- /dev/null
+++ b/main/audio/audio_lifecycle_policy.h
@@ -0,0 +1,79 @@
+#ifndef AUDIO_LIFECYCLE_POLICY_H
+#define AUDIO_LIFECYCLE_POLICY_H
+
+enum class AudioWorker : unsigned char {
+    Input = 1U << 0,
+    Output = 1U << 1,
+    Codec = 1U << 2,
+};
+
+class AudioLifecyclePolicy {
+public:
+    void OpenIntake() { accepting_input_ = true; }
+    void CloseIntake() { accepting_input_ = false; }
+
+    bool TryBeginInputWork()
+    {
+        if (!accepting_input_) {
+            return false;
+        }
+        input_work_active_ = true;
+        return true;
+    }
+
+    void EndInputWork() { input_work_active_ = false; }
+    bool InputQuiescent() const { return !input_work_active_; }
+
+    bool TryBeginEncoderWork()
+    {
+        if (encoder_work_active_) {
+            return false;
+        }
+        encoder_work_active_ = true;
+        return true;
+    }
+
+    void EndEncoderWork() { encoder_work_active_ = false; }
+
+    bool ProducersQuiescent(bool encode_queue_empty) const
+    {
+        return !accepting_input_ && !input_work_active_ && !encoder_work_active_ &&
+            encode_queue_empty;
+    }
+
+    void ResetWorkers()
+    {
+        created_workers_ = 0;
+        exited_workers_ = 0;
+        accepting_input_ = false;
+        input_work_active_ = false;
+        encoder_work_active_ = false;
+    }
+
+    void MarkWorkerCreated(AudioWorker worker) { created_workers_ |= Mask(worker); }
+    void MarkWorkerExited(AudioWorker worker) { exited_workers_ |= Mask(worker); }
+
+    bool AllWorkersExited() const
+    {
+        return (exited_workers_ & created_workers_) == created_workers_;
+    }
+
+    bool CanDestroy() const
+    {
+        return !input_work_active_ && !encoder_work_active_ && AllWorkersExited();
+    }
+
+private:
+    static constexpr unsigned char Mask(AudioWorker worker)
+    {
+        return static_cast<unsigned char>(worker);
+    }
+
+    bool accepting_input_ = false;
+    bool input_work_active_ = false;
+    bool encoder_work_active_ = false;
+    unsigned char created_workers_ = 0;
+    unsigned char exited_workers_ = 0;
+};
+
+#endif
diff --git a/main/audio/audio_lifecycle_state.h b/main/audio/audio_lifecycle_state.h
new file mode 100644
index 0000000..245bcb2
--- /dev/null
+++ b/main/audio/audio_lifecycle_state.h
@@ -0,0 +1,93 @@
+#ifndef AUDIO_LIFECYCLE_STATE_H
+#define AUDIO_LIFECYCLE_STATE_H
+
+#include <mutex>
+
+#include "audio_lifecycle_policy.h"
+
+class AudioLifecycleState {
+public:
+    void OpenIntake()
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        policy_.OpenIntake();
+    }
+
+    void CloseIntake()
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        policy_.CloseIntake();
+    }
+
+    bool TryBeginInputWork()
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return policy_.TryBeginInputWork();
+    }
+
+    void EndInputWork()
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        policy_.EndInputWork();
+    }
+
+    bool InputQuiescent() const
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return policy_.InputQuiescent();
+    }
+
+    bool TryBeginEncoderWork()
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return policy_.TryBeginEncoderWork();
+    }
+
+    void EndEncoderWork()
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        policy_.EndEncoderWork();
+    }
+
+    bool ProducersQuiescent(bool encode_queue_empty) const
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return policy_.ProducersQuiescent(encode_queue_empty);
+    }
+
+    void ResetWorkers()
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        policy_.ResetWorkers();
+    }
+
+    void MarkWorkerCreated(AudioWorker worker)
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        policy_.MarkWorkerCreated(worker);
+    }
+
+    void MarkWorkerExited(AudioWorker worker)
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        policy_.MarkWorkerExited(worker);
+    }
+
+    bool AllWorkersExited() const
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return policy_.AllWorkersExited();
+    }
+
+    bool CanDestroy() const
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return policy_.CanDestroy();
+    }
+
+private:
+    mutable std::mutex mutex_;
+    AudioLifecyclePolicy policy_;
+};
+
+#endif
diff --git a/main/audio/audio_output_dispatch_policy.h b/main/audio/audio_output_dispatch_policy.h
new file mode 100644
index 0000000..2b3ad8f
--- /dev/null
+++ b/main/audio/audio_output_dispatch_policy.h
@@ -0,0 +1,42 @@
+#ifndef AUDIO_OUTPUT_DISPATCH_POLICY_H
+#define AUDIO_OUTPUT_DISPATCH_POLICY_H
+
+class AudioOutputDispatchPolicy {
+public:
+    void DetachFrames(unsigned count) {
+        detached_frames_ += count;
+    }
+
+    bool BeginCallback() {
+        if (detached_frames_ == 0) {
+            return false;
+        }
+        --detached_frames_;
+        ++active_callbacks_;
+        return true;
+    }
+
+    void EndCallback() {
+        if (active_callbacks_ != 0) {
+            --active_callbacks_;
+        }
+    }
+
+    bool IsQuiescent() const {
+        return detached_frames_ == 0 && active_callbacks_ == 0;
+    }
+
+private:
+    unsigned detached_frames_ = 0;
+    unsigned active_callbacks_ = 0;
+};
+
+constexpr bool CanDeclareAudioDrain(
+    bool lifecycle_quiescent,
+    bool send_queue_empty,
+    bool processor_output_quiescent
+) {
+    return lifecycle_quiescent && send_queue_empty && processor_output_quiescent;
+}
+
+#endif
