+
+AudioServiceStopResult AudioService::StopInternal(bool drain, uint32_t timeout_ms) {
+    if (service_stopped_ && audio_input_task_handle_ == nullptr &&
+        audio_output_task_handle_ == nullptr && opus_codec_task_handle_ == nullptr) {
+        return AudioServiceStopResult::NotStarted;
+    }
+
+    const int64_t deadline_us = esp_timer_get_time() + static_cast<int64_t>(timeout_ms) * 1000;
+    if (drain) {
+        const auto drain_result = BeginDrain(timeout_ms);
+        const int64_t remaining_us = deadline_us - esp_timer_get_time();
+        const auto finish_result = FinishStop(
+            remaining_us > 0 ? static_cast<uint32_t>(remaining_us / 1000) : 0
+        );
+        if (finish_result != AudioServiceStopResult::Complete) {
+            return finish_result;
+        }
+        switch (drain_result) {
+            case AudioServiceDrainResult::Complete:
+                return AudioServiceStopResult::Complete;
+            case AudioServiceDrainResult::IncompleteProcessorTail:
+                return AudioServiceStopResult::IncompleteAudio;
+            case AudioServiceDrainResult::EncoderFailed:
+                return AudioServiceStopResult::EncodeFailed;
+            case AudioServiceDrainResult::InputQuiesceTimeout:
+                return AudioServiceStopResult::InputQuiesceTimeout;
+            case AudioServiceDrainResult::EncoderDrainTimeout:
+                return AudioServiceStopResult::DrainTimeout;
+            case AudioServiceDrainResult::NotStarted:
+                return AudioServiceStopResult::NotStarted;
+        }
+    }
+
+    if (audio_power_timer_ != nullptr) {
+        esp_timer_stop(audio_power_timer_);
+        runtime_state_.MarkTimerStopped();
+    }
+    lifecycle_.CloseIntake();
+    xEventGroupClearBits(event_group_, AS_EVENT_AUDIO_TESTING_RUNNING |
+        AS_EVENT_WAKE_WORD_RUNNING | AS_EVENT_AUDIO_PROCESSOR_RUNNING);
+    if (wake_word_ != nullptr) {
+        wake_word_->Stop();
+    }
+    const bool input_quiescent = WaitForInputQuiescence(deadline_us);
+    bool incomplete_audio = !input_quiescent;
+    if (input_quiescent && audio_processor_ != nullptr && runtime_state_.ProcessorPrepared()) {
+        incomplete_audio = audio_processor_->Stop() == AudioProcessorStopResult::IncompleteTail;
+    }
+    RequestWorkersStop();
+    const auto join_result = JoinWorkersAndProcessor(deadline_us);
+    if (join_result != AudioServiceStopResult::Complete) {
+        shutdown_failure_latched_ = true;
+        return join_result;
+    }
+    {
+        std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+        incomplete_audio = incomplete_audio || !audio_encode_queue_.empty() || !audio_send_queue_.empty();
+        incomplete_audio = incomplete_audio || runtime_state_.EncodeFailed();
+        audio_encode_queue_.clear();
+        audio_send_queue_.clear();
+        audio_decode_queue_.clear();
+        audio_playback_queue_.clear();
+        audio_testing_queue_.clear();
+        timestamp_queue_.clear();
+        capture_segments_.clear();
+        runtime_state_.ClearCaptureMetadata();
+        audio_queue_cv_.notify_all();
+    }
+    if (codec_ != nullptr) {
+        codec_->EnableInput(false);
+    }
+    drain_started_ = false;
+    runtime_state_.ResetAfterStop();
+    return incomplete_audio ? AudioServiceStopResult::IncompleteAudio
+                            : AudioServiceStopResult::Complete;
+}
+
+AudioServiceDrainResult AudioService::BeginDrain(uint32_t timeout_ms) {
+    if (service_stopped_) {
+        return AudioServiceDrainResult::NotStarted;
+    }
+    const int64_t deadline_us = esp_timer_get_time() + static_cast<int64_t>(timeout_ms) * 1000;
+    if (audio_power_timer_ != nullptr) {
+        esp_timer_stop(audio_power_timer_);
+        runtime_state_.MarkTimerStopped();
+    }
+    lifecycle_.CloseIntake();
+    xEventGroupClearBits(event_group_, AS_EVENT_AUDIO_TESTING_RUNNING |
+        AS_EVENT_WAKE_WORD_RUNNING | AS_EVENT_AUDIO_PROCESSOR_RUNNING);
+    if (wake_word_ != nullptr) {
+        wake_word_->Stop();
+    }
+    audio_queue_cv_.notify_all();
+    if (!WaitForInputQuiescence(deadline_us)) {
+        return AudioServiceDrainResult::InputQuiesceTimeout;
+    }
+
+    bool incomplete_tail = false;
+    if (audio_processor_ != nullptr && runtime_state_.ProcessorPrepared()) {
+        incomplete_tail = audio_processor_->Stop() == AudioProcessorStopResult::IncompleteTail;
+    }
+    if (!WaitForEncoderQuiescence(deadline_us)) {
+        return AudioServiceDrainResult::EncoderDrainTimeout;
+    }
+    drain_started_ = true;
+    {
+        std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+        switch (runtime_state_.ResolveDrain(incomplete_tail)) {
+            case AudioRuntimeDrainDisposition::Complete:
+                return AudioServiceDrainResult::Complete;
+            case AudioRuntimeDrainDisposition::IncompleteProcessorTail:
+                return AudioServiceDrainResult::IncompleteProcessorTail;
+            case AudioRuntimeDrainDisposition::EncodeFailed:
+                return AudioServiceDrainResult::EncoderFailed;
+        }
+    }
+    return AudioServiceDrainResult::EncoderFailed;
+}
+
+AudioServiceStopResult AudioService::FinishStop(uint32_t timeout_ms) {
+    if (service_stopped_ && audio_input_task_handle_ == nullptr &&
+        audio_output_task_handle_ == nullptr && opus_codec_task_handle_ == nullptr) {
+        return AudioServiceStopResult::NotStarted;
+    }
+    if (!drain_started_) {
+        return StopInternal(false, timeout_ms);
+    }
+    const int64_t deadline_us = esp_timer_get_time() + static_cast<int64_t>(timeout_ms) * 1000;
+    RequestWorkersStop();
+    const auto result = JoinWorkersAndProcessor(deadline_us);
+    if (result != AudioServiceStopResult::Complete) {
+        shutdown_failure_latched_ = true;
+        return result;
+    }
+    if (codec_ != nullptr) {
+        codec_->EnableInput(false);
+    }
+    {
+        std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+        capture_segments_.clear();
+        runtime_state_.ResetAfterStop();
+    }
+    drain_started_ = false;
+    return AudioServiceStopResult::Complete;
+}
+
+bool AudioService::WaitForInputQuiescence(int64_t deadline_us) {
+    while (!lifecycle_.InputQuiescent()) {
+        if (esp_timer_get_time() >= deadline_us) {
+            return false;
+        }
+        vTaskDelay(pdMS_TO_TICKS(1));
+    }
+    return true;
+}
 
